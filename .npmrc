# 把相依攤平到根 node_modules。
#
# 移除前先看 server/utils/test/cache-header.spec.ts：那支 canary 用
# `require.resolve('nitropack/package.json')` 讀 nitro 的原始碼，而 nitropack 是
# transitive dependency（nuxt → @nuxt/nitro-server），沒有列在 package.json。
# 改回 pnpm 預設的嚴格隔離，那行會直接 MODULE_NOT_FOUND，且錯誤訊息不會指向這裡。
shamefully-hoist=true
