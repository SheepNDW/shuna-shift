# Google Sheets API Key
# 從 Google Cloud Console 獲取: https://console.cloud.google.com/apis/credentials
NUXT_GSHEETS_KEY=your_google_sheets_api_key_here

# Google Spreadsheet ID
# 從表單 URL 中取得: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/
NUXT_SPREADSHEET_ID=your_spreadsheet_id_here

# 選填：canonical 與 og:url 用的站台網址
# 未設定時使用 nuxt.config.ts 的預設值（正式站網址）
# NUXT_PUBLIC_SITE_URL=https://shuna-shift.vercel.app
